rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTechnician(data) {
      return data.keys().hasAll(['id', 'name', 'ddd', 'active']) &&
             data.keys().hasOnly(['id', 'name', 'ddd', 'active', 'phone', 'notes', 'customColor', 'shiftHours']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.ddd is number &&
             data.active is bool;
    }

    function isValidOffRequest(data) {
      return data.keys().hasAll(['id', 'technicianId', 'date', 'status']) &&
             data.keys().hasOnly(['id', 'technicianId', 'date', 'reasonCategory', 'notes', 'priority', 'createdAt', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.technicianId is string && data.technicianId.size() <= 128 &&
             data.date is string && data.date.size() <= 20 &&
             data.status is string && data.status.size() <= 30;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role']) &&
             data.keys().hasOnly(['id', 'name', 'role', 'pin', 'isFirstLogin', 'technicianId', 'ddd']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.role is string && data.role.size() <= 30;
    }

    match /technicians/{technicianId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(technicianId) && isValidTechnician(request.resource.data);
      allow delete: if isSignedIn() && isValidId(technicianId);
    }

    match /offRequests/{requestId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(requestId) && isValidOffRequest(request.resource.data);
      allow delete: if isSignedIn() && isValidId(requestId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isSignedIn() && isValidId(userId);
    }
  }
}
